---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Escuela de Freediving Litoral" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Jost:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Freediving Litoral</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={base} class="brand-wordmark">
          {/* TODO: reemplazar por <img src={`${base}images/brand/logo-outline-navy.svg`} alt="Freediving Litoral" /> cuando se suban los archivos originales del logo */}
          Freediving Litoral
        </a>
        <nav class="main-nav">
          <ul>
            <li><a href={base}>Inicio</a></li>
            <li><a href={`${base}cursos`}>Cursos</a></li>
            <li><a href={`${base}nosotros`}>Nosotros</a></li>
            <li><a href={`${base}galeria`}>Galería</a></li>
            <li><a href={`${base}blog`}>Blog</a></li>
            <li><a href={`${base}reservas`}>Reservas</a></li>
            <li><a href={`${base}contacto`}>Contacto</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Freediving Litoral. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
