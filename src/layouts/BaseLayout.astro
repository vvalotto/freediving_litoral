---
import { getImage } from "astro:assets";
import Foto from "../components/Foto.astro";
import { cargarImagen } from "../lib/imagenes";
import { escuela } from "../lib/escuela";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Imagen para la vista previa al compartir (ruta relativa a src/assets/images) */
  image?: string;
  /** Datos estructurados (schema.org) propios de la página, además de los de la escuela */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image = "gallery/bajo-el-agua/buceador-rayos-luz.jpg", jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;

const tituloCompleto = `${title} · ${escuela.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const vistaPrevia = await getImage({
  src: await cargarImagen(image),
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 80,
});
const imagenAbsoluta = new URL(vistaPrevia.src, Astro.site).href;

const organizacion = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "@id": new URL(`${base}#escuela`, Astro.site).href,
  name: escuela.nombre,
  description: escuela.descripcion,
  url: new URL(base, Astro.site).href,
  logo: new URL(`${base}favicon-180.png`, Astro.site).href,
  sport: "Apnea (freediving)",
  email: escuela.email,
  telephone: escuela.telefono,
  sameAs: [escuela.instagram],
  memberOf: { "@type": "SportsOrganization", name: "FAAS — Federación Argentina de Actividades Subacuáticas", url: "https://www.faas.org.ar/" },
};
const datosEstructurados = jsonLd ? [organizacion, { "@context": "https://schema.org", ...jsonLd }] : [organizacion];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={escuela.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}favicon-180.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Jost:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{tituloCompleto}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={base} class="brand-wordmark">
          <Foto src={`brand/logo-icon-navy.png`} alt="" widths={[80, 160]} sizes="40px" loading="eager" />
          Freediving Litoral
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </label>
        <nav class="main-nav">
          <ul>
            <li><a href={base}>Inicio</a></li>
            <li><a href={`${base}cursos`}>Cursos</a></li>
            <li><a href={`${base}nosotros`}>Nosotros</a></li>
            <li><a href={`${base}galeria`}>Galería</a></li>
            <li><a href={`${base}contacto`}>Contacto</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <Foto src={`brand/logo-badge-navy.png`} alt="Freediving Litoral" class="footer-brand__logo" widths={[120, 240]} sizes="120px" />
          <p>Escuela de apnea habilitada por FAAS. Entrenamos en pileta, mar y lagunas con visibilidad.</p>
          <a class="footer-faas" href="https://www.faas.org.ar/" target="_blank" rel="noopener">
            <Foto src={`brand/faas-blanco.png`} alt="FAAS, Federación Argentina de Actividades Subacuáticas" loading="lazy" widths={[160, 320]} sizes="160px" />
          </a>
        </div>
        <div class="footer-links">
          <h3>Sitio</h3>
          <ul>
            <li><a href={base}>Inicio</a></li>
            <li><a href={`${base}cursos`}>Cursos</a></li>
            <li><a href={`${base}nosotros`}>Nosotros</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h3>Contacto</h3>
          <ul>
            <li><a href={`${base}contacto`}>Contacto</a></li>
            <li><a href={`${base}galeria`}>Galería</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Freediving Litoral. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
