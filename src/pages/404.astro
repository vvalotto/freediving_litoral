---
import Foto from "../components/Foto.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const atajos = [
  { titulo: "Cursos", texto: "Discovery y Apneísta Nivel 1 a 3", href: `${base}cursos` },
  { titulo: "Nosotros", texto: "El equipo y los atletas", href: `${base}nosotros` },
  { titulo: "Galería", texto: "Entrenamientos y competencias", href: `${base}galeria` },
  { titulo: "Contacto", texto: "WhatsApp, correo e Instagram", href: `${base}contacto` },
];
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de lugar."
  image="gallery/bajo-el-agua/buceador-descenso-oscuro.png"
  noindex
>
  <section class="perdido">
    <Foto
      class="perdido__photo"
      src="gallery/bajo-el-agua/buceador-descenso-oscuro.png"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
    <div class="perdido__scrim"></div>
    <div class="container perdido__content">
      <p class="eyebrow">Error 404</p>
      <h1>
        <span>Esta página</span>
        <span>se fue a lo profundo</span>
      </h1>
      <p class="perdido__lead">
        No encontramos lo que buscabas. Puede que el enlace esté mal escrito o que la página haya
        cambiado de lugar. Volvé a la superficie y seguí desde acá.
      </p>
      <div class="perdido__actions">
        <a class="btn btn--solid" href={base}>Ir al inicio</a>
        <a class="btn btn--outline" href={`${base}cursos`}>Ver cursos</a>
      </div>
    </div>
  </section>

  <nav class="container section atajos" aria-label="Secciones del sitio">
    <h2>¿Qué estabas buscando?</h2>
    <ul class="atajos__grid">
      {
        atajos.map((atajo) => (
          <li>
            <a class="atajos__card" href={atajo.href}>
              <span class="atajos__titulo">{atajo.titulo} →</span>
              <span class="atajos__texto">{atajo.texto}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .perdido {
    position: relative;
    overflow: hidden;
    padding-block: 4rem;
  }

  .perdido__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .perdido__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(4, 12, 20, 0.88) 0%,
      rgba(4, 12, 20, 0.65) 50%,
      rgba(4, 12, 20, 0.3) 100%
    );
  }

  .perdido__content {
    position: relative;
  }

  .perdido .eyebrow {
    color: var(--color-blue-400);
  }

  .perdido h1 {
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0.5rem 0 1.25rem;
  }

  .perdido h1 span {
    display: block;
  }

  .perdido__lead {
    max-width: 44ch;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
  }

  .perdido__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .perdido .btn--outline {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  @media (min-width: 800px) {
    .perdido {
      padding-block: 6rem;
    }
  }

  .atajos h2 {
    margin: 0 0 1.5rem;
  }

  .atajos__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .atajos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .atajos__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .atajos__card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: rgba(79, 163, 209, 0.1);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .atajos__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(11, 37, 69, 0.12);
  }

  .atajos__titulo {
    color: var(--color-navy-900);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .atajos__texto {
    color: var(--color-navy-700);
    font-size: 0.9rem;
  }
</style>
