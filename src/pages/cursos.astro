---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const cursos = (await getCollection("cursos")).sort(
  (a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0)
);
---

<BaseLayout title="Cursos">
  <section class="page-header">
    <img
      class="page-header__photo"
      src={`${base}images/gallery/instructores-alumnos-pileta-cubierta.jpg`}
      alt="Instructor cronometrando a un alumno en apnea estática"
    />
    <div class="page-header__scrim"></div>
    <div class="container page-header__content">
      <div class="page-header__card">
        <h1>Cursos</h1>
        <ul>
          {
            cursos.map((curso) => (
              <li>
                <strong>{curso.data.titulo}</strong>
                {curso.data.nivel && ` — ${curso.data.nivel}`}
                {curso.data.duracion && ` (${curso.data.duracion})`}
                <p>{curso.data.resumen}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: 2.5rem;
  }

  .page-header__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .page-header__scrim {
    position: absolute;
    inset: 0;
    background: rgba(4, 12, 20, 0.35);
  }

  .page-header__content {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .page-header__card {
    background: var(--color-white);
    border-radius: 1rem;
    padding: 1.5rem 2rem;
    box-shadow: 0 10px 30px rgba(4, 12, 20, 0.25);
    max-width: 34rem;
  }

  .page-header h1 {
    margin: 0 0 1rem;
  }

  .page-header__card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .page-header__card li strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .page-header__card li p {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 800px) {
    .page-header {
      padding-block: 4rem;
    }

    .page-header__content {
      justify-content: flex-end;
    }

    .page-header__card {
      padding: 2.5rem 3rem;
    }
  }
</style>
