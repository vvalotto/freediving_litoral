---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const cursos = (await getCollection("cursos")).sort(
  (a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0)
);
---

<BaseLayout title="Cursos">
  <section class="page-header">
    <img
      class="page-header__photo"
      src={`${base}images/gallery/entrenamiento/estiramiento-nocturno-grupal.jpeg`}
      alt="Grupo haciendo estiramiento nocturno junto a la pileta"
    />
    <div class="page-header__scrim"></div>
    <div class="container page-header__content">
      <div class="page-header__text">
        <h1>Cursos</h1>
        <p class="page-header__lead">
          Desde tu primer curso hasta el entrenamiento orientado a competencia.
        </p>
      </div>
    </div>
  </section>

  <div class="container section cursos-list">
    {
      cursos.map((curso, i) => (
        <article class={`curso-block ${i % 2 === 1 ? "curso-block--alt" : ""}`}>
          <img
            class="curso-block__photo"
            src={`${base}images/gallery/${curso.data.fotoPortada}`}
            alt={curso.data.fotoPortadaAlt}
            loading="lazy"
          />
          <div class="curso-block__body">
            <p class="eyebrow">
              {curso.data.nivel}
              {curso.data.duracion && ` · ${curso.data.duracion}`}
            </p>
            <h2>{curso.data.titulo}</h2>
            {curso.data.introduccion?.map((parrafo) => <p class="curso-block__intro">{parrafo}</p>)}
            {curso.data.destacados && (
              <ul class="curso-block__chips">
                {curso.data.destacados.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {curso.data.secciones && (
              <div class="acc">
                {curso.data.secciones.map((seccion, j) => (
                  <div class={`acc-item acc-item--tone${j % 2}`}>
                    <input type="checkbox" id={`${curso.id}-${j}`} class="acc-toggle" checked={j === 0} />
                    <label for={`${curso.id}-${j}`} class="acc-header">
                      <span>{seccion.titulo}</span>
                      <svg class="acc-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </label>
                    <div class="acc-body-wrap">
                      <div class="acc-body">
                        {seccion.parrafos.map((parrafo) => <p>{parrafo}</p>)}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
            {curso.data.requisitos && (
              <p class="curso-block__requisitos">
                <strong>Requisitos:</strong> {curso.data.requisitos}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="container section discipline-cta">
    <a class="btn btn--solid" href={`${base}contacto`}>Consultar e inscribirme</a>
    <a class="btn btn--outline" href={`${base}nosotros`}>Conocé al equipo</a>
  </div>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: 3rem;
  }

  .page-header__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 72%;
    display: block;
  }

  .page-header__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(4, 12, 20, 0.85) 0%,
      rgba(4, 12, 20, 0.65) 45%,
      rgba(4, 12, 20, 0.25) 100%
    );
  }

  .page-header__content {
    position: relative;
  }

  .page-header__text {
    max-width: 40rem;
  }

  .page-header h1 {
    color: #fff;
    margin: 0 0 1rem;
  }

  .page-header__lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    margin: 0;
    max-width: 48ch;
  }

  @media (min-width: 800px) {
    .page-header {
      padding-block: 4.5rem;
    }
  }

  .cursos-list {
    display: grid;
    gap: 4rem;
  }

  .curso-block {
    display: grid;
    gap: 1.75rem;
  }

  .curso-block__photo {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 1rem;
    display: block;
  }

  .curso-block__body .eyebrow {
    color: var(--color-accent);
  }

  .curso-block__body h2 {
    margin: 0.3rem 0 1rem;
  }

  .curso-block__intro {
    color: var(--color-navy-700);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .curso-block__chips {
    list-style: none;
    margin: 1.25rem 0 1.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .curso-block__chips li {
    background: var(--color-blue-100);
    color: var(--color-navy-900);
    font-size: 0.85rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
  }

  .curso-block__requisitos {
    margin-top: 1.5rem;
    color: var(--color-navy-700);
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .curso-block {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .curso-block--alt .curso-block__photo {
      order: 2;
    }
  }

  .acc {
    display: grid;
    gap: 1rem;
  }

  .acc-item {
    border-radius: 1rem;
    overflow: hidden;
  }

  .acc-item--tone0 {
    background: rgba(79, 163, 209, 0.12);
  }

  .acc-item--tone1 {
    background: rgba(11, 37, 69, 0.06);
  }

  .acc-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .acc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    font-family: var(--font-base);
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-navy-900);
  }

  .acc-chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .acc-toggle:checked + .acc-header .acc-chevron {
    transform: rotate(180deg);
  }

  .acc-body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .acc-toggle:checked ~ .acc-body-wrap {
    grid-template-rows: 1fr;
  }

  .acc-body {
    overflow: hidden;
  }

  .acc-body p {
    margin: 0 0 0.9rem 1.3rem;
    padding-right: 1.3rem;
    color: var(--color-navy-700);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .acc-body p:last-child {
    margin-bottom: 1.3rem;
  }

  .discipline-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
