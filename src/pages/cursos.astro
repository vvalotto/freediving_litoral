---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const cursos = (await getCollection("cursos")).sort(
  (a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0)
);
---

<BaseLayout title="Cursos">
  <section class="page-header">
    <img
      class="page-header__photo"
      src={`${base}images/gallery/instructores-alumnos-pileta-cubierta.jpg`}
      alt="Instructor cronometrando a un alumno en apnea estática"
    />
    <div class="container page-header__content">
      <div class="page-header__panel">
        <h1>Cursos</h1>
        <ul>
          {
            cursos.map((curso) => (
              <li>
                <strong>{curso.data.titulo}</strong>
                {curso.data.nivel && ` — ${curso.data.nivel}`}
                {curso.data.duracion && ` (${curso.data.duracion})`}
                <p>{curso.data.resumen}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    display: grid;
    min-height: clamp(22rem, 60vh, 30rem);
    overflow: hidden;
  }

  .page-header__photo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .page-header__content {
    grid-area: 1 / 1;
    align-self: center;
    padding-block: 3rem;
  }

  .page-header__panel {
    display: inline-block;
    background: rgba(11, 37, 69, 0.62);
    backdrop-filter: blur(2px);
    padding: 2rem 1.75rem;
    border-radius: 0.5rem;
    color: #fff;
  }

  .page-header h1 {
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0 0 1.25rem;
  }

  .page-header__panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .page-header__panel li strong {
    display: block;
    margin-bottom: 0.25rem;
    color: #fff;
  }

  .page-header__panel li p {
    margin: 0.35rem 0 0;
    color: rgba(255, 255, 255, 0.82);
  }

  @media (min-width: 800px) {
    .page-header__panel {
      padding: 3rem 3.5rem;
    }
  }
</style>
