---

<BaseLayout title="Galería">
  <div class="container section">
    <h1>Galería</h1>
    <p>Fotos de entrenamientos, salidas y del equipo de instructores.</p>
    {
      secciones.map((seccion) => (
        <div class="gallery-section">
          <h2>{seccion.titulo}</h2>
          <div class="gallery-grid">
            {seccion.fotos.map((foto) => (
              <img src={`${base}images/gallery/${foto.archivo}`} alt={foto.alt} loading="lazy" />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gallery-section {
    margin-top: 2.5rem;
  }

  .gallery-section h2 {
    margin-bottom: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
