---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const fotos = [
  { archivo: "entrenamiento-pileta-dinamica.jpeg", alt: "Alumnos entrenando apnea dinámica en pileta" },
  { archivo: "entrenamiento-nocturno-monoaletas.jpeg", alt: "Instructor con alumnos usando monoaleta, entrenamiento nocturno" },
  { archivo: "estiramiento-grupal.jpeg", alt: "Grupo haciendo estiramiento previo al entrenamiento" },
  { archivo: "equipo-piscina-profunda.jpeg", alt: "Equipo en piscina de entrenamiento profundo" },
  { archivo: "equipo-trajes-neopreno.jpeg", alt: "Equipo de instructores con trajes de neopreno" },
  { archivo: "equipo-centro-buceo.jpeg", alt: "Equipo en el centro de buceo" },
  { archivo: "equipo-pileta-cubierta.jpeg", alt: "Grupo en pileta cubierta" },
];
---

<BaseLayout title="Galería">
  <div class="container section">
    <h1>Galería</h1>
    <p>Fotos de entrenamientos, salidas y del equipo de instructores.</p>
    <div class="gallery-grid">
      {
        fotos.map((foto) => (
          <img src={`${base}images/gallery/${foto.archivo}`} alt={foto.alt} loading="lazy" />
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
