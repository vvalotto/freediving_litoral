---

<BaseLayout
  title="Galería"
  description="Fotos de entrenamientos en pileta, salidas a aguas abiertas, competencias y del equipo de Freediving Litoral."
  image="gallery/entrenamiento/entrenamiento-nocturno-monoaletas.jpeg"
>
  <div class="container section">
    <h1>Galería</h1>
    <p>Fotos de entrenamientos, salidas y del equipo de instructores.</p>
    {
      secciones.map((seccion) => (
        <div class="gallery-section">
          <h2>{seccion.titulo}</h2>
          <div class:list={["gallery-grid", { "gallery-grid--vertical": seccion.vertical }]}>
            {seccion.fotos.map((foto) => (
              <Foto
                src={`gallery/${foto.archivo}`}
                alt={foto.alt}
                loading="lazy"
                class={foto.ancho ? "wide" : undefined}
                style={foto.pos ? `object-position: center ${foto.pos};` : undefined} widths={[400, 800, 1200]} sizes="(min-width: 700px) 33vw, 50vw" />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gallery-section {
    margin-top: 2.5rem;
  }

  .gallery-section h2 {
    margin-bottom: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .gallery-grid--vertical {
    grid-auto-flow: dense;
  }

  .gallery-grid--vertical img {
    aspect-ratio: 3 / 4;
  }

  .gallery-grid--vertical img.wide {
    grid-column: span 2;
    aspect-ratio: 1.55 / 1;
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
