---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const secciones = [
  {
    titulo: "En el agua",
    fotos: [
      { archivo: "bajo-el-agua/buceador-rayos-luz.jpg", alt: "Buceador nadando entre rayos de luz bajo el agua" },
      { archivo: "bajo-el-agua/buceador-ascenso-luz.jpg", alt: "Buceador ascendiendo hacia la luz de superficie" },
      { archivo: "bajo-el-agua/buceador-cabo-profundidad.jpg", alt: "Buceador en profundidad junto al cabo de descenso" },
      { archivo: "bajo-el-agua/buceador-superficie-luz.jpg", alt: "Buceador mirando hacia la luz de la superficie" },
      { archivo: "bajo-el-agua/retrato-mascara-apnea.jpg", alt: "Retrato de un apneísta con máscara bajo el agua" },
      { archivo: "bajo-el-agua/arrecife-tropical-peces.jpg", alt: "Arrecife tropical con peces de colores" },
      { archivo: "bajo-el-agua/buceador-arpon-ascenso.jpg", alt: "Buceador ascendiendo por el cabo hacia la superficie" },
      { archivo: "bajo-el-agua/buceador-silueta-verde-cabo.jpg", alt: "Apneísta ascendiendo junto al cabo en aguas verdes" },
      { archivo: "bajo-el-agua/nadadores-superficie-mar-abierto.png", alt: "Siluetas de apneístas en la superficie a contraluz en mar abierto" },
      { archivo: "bajo-el-agua/profundidad-2.png", alt: "Apneísta en profundidad con un haz de luz" },
      { archivo: "bajo-el-agua/buceador-aletas-descenso-oscuro.png", alt: "Apneísta con aletas descendiendo por el cabo en aguas oscuras" },
    ],
  },
  {
    titulo: "Entrenamiento",
    fotos: [
      { archivo: "entrenamiento/entrenamiento-pileta-dinamica.jpeg", alt: "Alumnos entrenando apnea dinámica en pileta" },
      { archivo: "entrenamiento/entrenamiento-nocturno-monoaletas.jpeg", alt: "Instructor con alumnos usando monoaleta, entrenamiento nocturno" },
      { archivo: "entrenamiento/instructor-alumno-tecnica.jpeg", alt: "Instructor corrigiendo la técnica de un alumno en pileta" },
      { archivo: "entrenamiento/nado-dinamico-grupal.jpeg", alt: "Grupo nadando apnea dinámica en pileta" },
      { archivo: "entrenamiento/apnea-monoaleta-accion.jpeg", alt: "Apneísta nadando con monoaleta" },
      { archivo: "entrenamiento/senal-ok-seguridad.jpg", alt: "Buceador haciendo la señal de OK como protocolo de seguridad" },
      { archivo: "entrenamiento/estiramiento-grupal.jpeg", alt: "Grupo haciendo estiramiento previo al entrenamiento" },
      { archivo: "equipo/equipo-piscina-profunda.jpeg", alt: "Equipo en piscina de entrenamiento profundo" },
    ],
  },
  {
    titulo: "Equipo y comunidad",
    fotos: [
      { archivo: "equipo/equipo-trajes-neopreno.jpeg", alt: "Equipo de instructores con trajes de neopreno" },
      { archivo: "equipo/equipo-centro-buceo.jpeg", alt: "Equipo en el centro de buceo" },
      { archivo: "equipo/equipo-pileta-cubierta.jpeg", alt: "Grupo en pileta cubierta" },
      { archivo: "bajo-el-agua/salida-mar-abierto.jpg", alt: "Salida en bote a mar abierto con el equipo" },
      { archivo: "competencia/competencia-internacional.jpeg", alt: "Equipo en competencia internacional de apnea" },
    ],
  },
  {
    titulo: "Logros",
    fotos: [
      { archivo: "competencia/podio-campeonato-cmas.jpg", alt: "Podio de campeonato con banner de CMAS" },
      { archivo: "competencia/ceremonia-entrega-medallas.jpeg", alt: "Ceremonia de entrega de medallas y certificados" },
      { archivo: "competencia/logro-equipo-certificados.jpg", alt: "Equipo con medallas y certificados de competencia" },
    ],
  },
];
---

<BaseLayout title="Galería">
  <div class="container section">
    <h1>Galería</h1>
    <p>Fotos de entrenamientos, salidas y del equipo de instructores.</p>
    {
      secciones.map((seccion) => (
        <div class="gallery-section">
          <h2>{seccion.titulo}</h2>
          <div class="gallery-grid">
            {seccion.fotos.map((foto) => (
              <img src={`${base}images/gallery/${foto.archivo}`} alt={foto.alt} loading="lazy" />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gallery-section {
    margin-top: 2.5rem;
  }

  .gallery-section h2 {
    margin-bottom: 1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
