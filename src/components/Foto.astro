---
// Imagen optimizada: genera WebP en varios anchos (srcset) a partir de src/assets/images.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "width" | "height"> {
  /** Ruta relativa a src/assets/images, p. ej. "gallery/equipo/foto.jpg" */
  src: string;
  alt: string;
  /** Anchos a generar; se descartan los mayores que el original */
  widths?: number[];
  sizes?: string;
}

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,JPG,png,webp}"
);

const { src, alt, widths = [480, 800, 1200, 1600, 2000], sizes = "100vw", ...attrs } = Astro.props;

const cargar = imagenes[`/src/assets/images/${src}`];
if (!cargar) throw new Error(`Imagen no encontrada en src/assets/images: ${src}`);
const imagen = (await cargar()).default;

const anchos = widths.filter((w) => w < imagen.width);
if (anchos.length === 0 || anchos.at(-1)! < Math.min(imagen.width, Math.max(...widths))) {
  anchos.push(Math.min(imagen.width, Math.max(...widths)));
}
---

<Image src={imagen} alt={alt} widths={anchos} sizes={sizes} format="webp" quality={78} {...attrs} />
