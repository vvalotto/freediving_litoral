---
import Foto from "./Foto.astro";
const base = import.meta.env.BASE_URL;

const disciplinas = [
  {
    titulo: "Apnea Estática (STA)",
    texto: "Control de la respiración y la mente en superficie: la base de todo entrenamiento de apnea.",
    foto: "entrenamiento/instructores-alumnos-pileta-cubierta.jpg",
    alt: "Instructor cronometrando a un alumno en apnea estática",
    slug: "sta",
  },
  {
    titulo: "Dinámica sin Aletas (DNF)",
    texto: "Control de flotabilidad, posición corporal y técnica de brazada y pateo de pecho bajo el agua.",
    foto: "entrenamiento/DNF-2.png",
    alt: "Apneísta nadando dinámica sin aletas",
    slug: "dnf",
  },
  {
    titulo: "Dinámica con Monoaleta (DYN)",
    texto: "Distancia en desplazamiento con monoaleta, con protocolos de seguridad activa.",
    foto: "entrenamiento/buceador-monoaleta-centrado.jpg",
    alt: "Apneísta nadando con monoaleta en pileta",
    slug: "dyn",
  },
  {
    titulo: "Dinámica con Aletas (DYNB)",
    texto: "Distancia en desplazamiento con aletas separadas, con protocolos de seguridad activa.",
    foto: "entrenamiento/dynb.jpg",
    alt: "Apneísta nadando con aletas separadas en pileta",
    slug: "dynb",
  },
];
---

<section class="section feature-grid">
  <div class="container">
    <h2>Disciplinas que trabajamos</h2>
    <div class="feature-grid__list">
      {
        disciplinas.map((d) => (
          <div class="feature-grid__item">
            <Foto
              class="feature-grid__photo"
              src={`gallery/${d.foto}`}
              alt={d.alt}
              loading="lazy"
              style={d.posicion ? `object-position: center ${d.posicion};` : undefined} widths={[480, 800, 1200]} sizes="(min-width: 800px) 33vw, 100vw" />
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
            <a class="feature-grid__link" href={`${base}disciplinas/${d.slug}`}>
              Ver detalle <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature-grid {
    background: var(--color-navy-900);
    color: var(--color-blue-100);
  }

  .feature-grid h2 {
    text-align: center;
    color: var(--color-white);
  }

  .feature-grid__list {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .feature-grid__link {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--color-blue-400);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .feature-grid__link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .feature-grid__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 1rem;
  }

  .feature-grid__item h3 {
    font-family: var(--font-base);
    color: var(--color-white);
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .feature-grid__item p {
    margin: 0;
    color: var(--color-blue-100);
    font-size: 0.95rem;
  }

  @media (min-width: 600px) {
    .feature-grid__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .feature-grid__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
