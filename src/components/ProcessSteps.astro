---
const base = import.meta.env.BASE_URL;

const steps = [
  {
    titulo: "Curso Inicial (1 mes, 8 sesiones)",
    texto: "Dos clases semanales de 3 horas (teoría + práctica en pileta): fisiología, seguridad, apnea estática y dinámica, hasta la evaluación final.",
    foto: "nado-dinamico-grupal.jpeg",
    alt: "Alumnos aprendiendo apnea dinámica en pileta",
  },
  {
    titulo: "Grupo de Entrenamiento Continuo",
    texto: "Entrenamiento anual, 2 días por semana, con periodización, técnica refinada y evaluaciones periódicas de marcas personales.",
    foto: "apnea-monoaleta-accion.jpeg",
    alt: "Apneísta entrenando técnica con monoaleta",
  },
  {
    titulo: "Competencia",
    texto: "Preparación y participación en torneos nacionales e internacionales de apnea estática y dinámica (AIDA / CMAS).",
    foto: "podio-amarillo-escuela-cetaceos.jpg",
    alt: "Podio de campeonato de apnea",
    posicion: "22%",
  },
];
---

<section class="section process">
  <div class="container">
    <h2>¿Cómo es el camino?</h2>
    <p class="process__lead">
      Ya seas nuevo en la apnea o quieras seguir progresando, así acompañamos tu recorrido.
    </p>
    <div class="process__list">
      {
        steps.map((step) => (
          <div class="process__item">
            <img
              class="process__photo"
              src={`${base}images/gallery/${step.foto}`}
              alt={step.alt}
              loading="lazy"
              style={step.posicion ? `object-position: center ${step.posicion};` : undefined}
            />
            <h3>{step.titulo}</h3>
            <p>{step.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-white);
  }

  .process h2 {
    text-align: center;
  }

  .process__lead {
    text-align: center;
    max-width: 50ch;
    margin: 0.75rem auto 2.5rem;
    color: var(--color-text-muted);
  }

  .process__list {
    display: grid;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .process__item {
    background: var(--color-blue-100);
    border-radius: 0.9rem;
    padding: 1.25rem;
  }

  .process__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.65rem;
    margin-bottom: 1rem;
  }

  .process__item h3 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .process__item p {
    margin: 0;
    color: var(--color-navy-700);
  }

  @media (min-width: 700px) {
    .process__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
