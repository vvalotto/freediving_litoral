---
const base = import.meta.env.BASE_URL;

const equipo = [
  {
    nombre: "Raúl Urquiza",
    perfil: ["Instructor principal, niveles I y II Indoor/Outdoor", "Apneísta de seguridad Indoor", "Competidor", "Juez de competencia"],
    foto: "raul-urquiza.png",
  },
  {
    nombre: "Cristina Figueroa Vasquez",
    perfil: ["Instructora nivel I Indoor", "Apneísta de seguridad Indoor", "Competidora", "Jueza de competencia"],
    foto: "cristina-figueroa.png",
  },
  {
    nombre: "José Clementi",
    perfil: ["Instructor nivel I Indoor", "Apneísta de seguridad Indoor", "Competidor"],
    foto: "jose-clementi.png",
  },
  {
    nombre: "Victor Valotto",
    perfil: ["Instructor nivel I Indoor", "Apneísta de seguridad Indoor", "Competidor"],
    foto: "victor-valotto.png",
  },
];
---

<section class="section team">
  <img class="team__photo" src={`${base}images/gallery/buceador-cabo-profundidad.jpg`} alt="" />
  <div class="team__scrim"></div>
  <div class="container team__content">
    <h2>Nuestro equipo</h2>
    <div class="team__grid">
      {
        equipo.map((persona) => (
          <div class="team__card">
            <img src={`${base}images/team/${persona.foto}`} alt={persona.nombre} />
            <h3>{persona.nombre}</h3>
            <ul>
              {persona.perfil.map((linea) => <li>{linea}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team {
    position: relative;
    overflow: hidden;
  }

  .team__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .team__scrim {
    position: absolute;
    inset: 0;
    background: rgba(220, 237, 247, 0.9);
  }

  .team__content {
    position: relative;
  }

  .team__grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .team__card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1rem;
    margin-bottom: 0.85rem;
  }

  .team__card h3 {
    font-family: var(--font-base);
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
  }

  .team__card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.2rem;
  }

  .team__card li {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 700px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
