---
const base = import.meta.env.BASE_URL;

const equipo = [
  { nombre: "Raúl Urquiza", rol: "Instructor principal, niveles I y II Indoor/Outdoor · Juez de competencia", foto: "raul-urquiza.png" },
  { nombre: "Cristina Figueroa", rol: "Instructora nivel I Indoor · Jueza de competencia", foto: "cristina-figueroa.png" },
  { nombre: "Dr. José Clementi", rol: "Instructor nivel I Indoor", foto: "jose-clementi.png" },
  { nombre: "Ing. Victor Valotto", rol: "Instructor nivel I Indoor", foto: "victor-valotto.png" },
];
---

<section class="section team">
  <div class="container">
    <h2>Nuestro equipo</h2>
    <p class="team__lead">
      Todos somos apneistas certificados en niveles I y II Indoor/Outdoor y apneístas de
      seguridad. Raúl Urquiza es nuestro instructor principal; junto a Cristina Figueroa,
      también se desempeñan como jueces de competencia.
    </p>
    <div class="team__grid">
      {
        equipo.map((persona) => (
          <div class="team__card">
            <img src={`${base}images/team/${persona.foto}`} alt={persona.nombre} />
            <h3>{persona.nombre}</h3>
            <p>{persona.rol}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team__lead {
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .team__grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .team__card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1rem;
    margin-bottom: 0.85rem;
  }

  .team__card h3 {
    font-family: var(--font-base);
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
  }

  .team__card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 700px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
