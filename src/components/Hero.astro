---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <img
    class="hero__photo"
    src={`${base}images/gallery/buceador-rayos-luz.jpg`}
    alt="Buceador nadando entre rayos de luz bajo el agua"
  />
  <div class="hero__scrim"></div>
  <div class="container hero__content">
    <p class="eyebrow">Escuela de Apnea · Habilitada por FAAS</p>
    <h1>Explorá tus límites bajo el agua</h1>
    <p class="hero__lead">
      Formación de apneistas con estándares de seguridad internacional. Entrenamos en pileta,
      mar y lagunas con visibilidad, con foco en técnica, seguridad y progreso real.
    </p>
    <div class="hero__actions">
      <a class="btn btn--solid" href={`${base}cursos`}>Ver cursos</a>
      <a class="btn btn--outline" href={`${base}nosotros`}>Conocenos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 34rem;
    overflow: hidden;
  }

  .hero__photo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 50%;
    display: block;
  }

  .hero__scrim {
    grid-area: 1 / 1;
    background: linear-gradient(
      100deg,
      rgba(4, 12, 20, 0.88) 0%,
      rgba(4, 12, 20, 0.72) 32%,
      rgba(4, 12, 20, 0.32) 60%,
      rgba(4, 12, 20, 0.1) 100%
    );
  }

  .hero__content {
    grid-area: 1 / 1;
    align-self: center;
    padding-block: 4rem;
    color: #fff;
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin: 0.4rem 0 1rem;
    max-width: 16ch;
  }

  .hero__lead {
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero .btn--outline {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  @media (min-width: 800px) {
    .hero {
      min-height: 40rem;
    }
  }
</style>
