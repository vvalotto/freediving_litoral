---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <img
    class="hero__photo"
    src={`${base}images/gallery/buceador-rayos-luz.jpg`}
    alt="Buceador nadando entre rayos de luz bajo el agua"
  />
  <div class="container hero__content">
    <div class="hero__panel">
      <p class="eyebrow">Escuela de Apnea · Habilitada por FAAS</p>
      <h1>
        <span>Explorá</span>
        <span>tus límites</span>
        <span>bajo el agua</span>
      </h1>
      <p class="hero__lead">
        Formación de apneistas con estándares de seguridad internacional. Entrenamos en pileta,
        mar y lagunas con visibilidad, con foco en técnica, seguridad y progreso real.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={`${base}cursos`}>Ver cursos</a>
        <a class="btn btn--outline" href={`${base}nosotros`}>Conocenos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(22rem, 60vh, 30rem);
    overflow: hidden;
  }

  .hero__photo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 50%;
    display: block;
  }

  .hero__content {
    grid-area: 1 / 1;
    align-self: center;
    padding-block: 3rem;
  }

  .hero__panel {
    display: inline-block;
    background: rgba(11, 37, 69, 0.62);
    backdrop-filter: blur(2px);
    padding: 2rem 1.75rem;
    border-radius: 0.5rem;
    color: #fff;
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero h1 {
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0.5rem 0 1.25rem;
  }

  .hero h1 span {
    display: block;
  }

  .hero__lead {
    max-width: 42ch;
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero .btn--outline {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  @media (min-width: 800px) {
    .hero__panel {
      padding: 3rem 3.5rem;
    }
  }
</style>
