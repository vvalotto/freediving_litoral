---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <img
    class="hero__photo"
    src={`${base}images/gallery/buceador-rayos-luz.jpg`}
    alt="Buceador nadando entre rayos de luz bajo el agua"
  />
  <div class="hero__scrim"></div>
  <div class="container hero__content">
    <div class="hero__text">
      <p class="eyebrow">Escuela de Apnea · Habilitada por FAAS</p>
      <h1>
        <span>Explorá</span>
        <span>tus límites</span>
        <span>bajo el agua</span>
      </h1>
      <p class="hero__lead">
        Formación de apneistas con estándares de seguridad internacional. Entrenamos en pileta,
        mar y lagunas con visibilidad, con foco en técnica, seguridad y progreso real.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={`${base}cursos`}>Ver cursos</a>
        <a class="btn btn--outline" href={`${base}nosotros`}>Conocenos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 3rem;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 50%;
    display: block;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(4, 12, 20, 0.85) 0%,
      rgba(4, 12, 20, 0.65) 45%,
      rgba(4, 12, 20, 0.25) 100%
    );
  }

  .hero__content {
    position: relative;
  }

  .hero__text {
    max-width: 40rem;
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero h1 {
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0.5rem 0 1.25rem;
  }

  .hero h1 span {
    display: block;
  }

  .hero__lead {
    max-width: 42ch;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero .btn--outline {
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }

  @media (min-width: 800px) {
    .hero {
      padding-block: 4.5rem;
    }
  }
</style>
