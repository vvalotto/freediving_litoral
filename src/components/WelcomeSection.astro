---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
const base = import.meta.env.BASE_URL;
---

<section class="section welcome">
  <div class="container welcome__grid">
    <div class="welcome__collage">
      <div class="welcome__photo welcome__photo--main">
        <PhotoPlaceholder label="Foto: instructor con alumnos" ratio="3 / 4" variant="navy" />
      </div>
      <div class="welcome__photo welcome__photo--accent">
        <PhotoPlaceholder label="Foto: salida en el río" ratio="4 / 3" variant="blue" />
      </div>
      <svg class="welcome__shape welcome__shape--wave" viewBox="0 0 120 40" aria-hidden="true">
        <path d="M0 20 Q 15 5, 30 20 T 60 20 T 90 20 T 120 20" fill="none" stroke="var(--color-blue-400)" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <svg class="welcome__shape welcome__shape--circle" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="46" fill="none" stroke="var(--color-navy-900)" stroke-width="3"/>
      </svg>
    </div>
    <div class="welcome__copy">
      <p class="eyebrow eyebrow--script">¡Hola!</p>
      <h2>Bienvenidos a Freediving Litoral</h2>
      <p>
        Contenido pendiente: historia de la escuela, quiénes son los instructores y qué los llevó a
        enseñar apnea en el litoral. Acá va una presentación cercana, en primera persona.
      </p>
      <a class="btn btn--solid" href={`${base}nosotros`}>Nuestro método</a>
    </div>
  </div>
</section>

<style>
  .welcome {
    background: var(--color-blue-100);
  }

  .welcome__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .welcome__collage {
    position: relative;
    padding: 1rem 2rem 2rem 0;
  }

  .welcome__photo--main {
    max-width: 260px;
  }

  .welcome__photo--accent {
    max-width: 200px;
    margin-left: auto;
    margin-top: -3rem;
    position: relative;
    z-index: 1;
  }

  .welcome__shape {
    position: absolute;
  }

  .welcome__shape--wave {
    width: 90px;
    bottom: -0.5rem;
    left: -0.5rem;
  }

  .welcome__shape--circle {
    width: 70px;
    top: -1.5rem;
    right: 1.5rem;
    opacity: 0.6;
  }

  .welcome__copy h2 {
    margin: 0.3rem 0 1rem;
  }

  .eyebrow--script {
    font-family: "Cinzel", serif;
    font-style: italic;
    font-size: 1.1rem;
  }

  @media (min-width: 800px) {
    .welcome__grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>
